# ==============================================================================
# SECURE PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local Docker and development usage. NEVER commit real secrets.
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=1433
DB_NAME=SecurePortalDb
DB_USER=sa
DB_PASSWORD=YourStrong@Password!2026

# Backend Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+:7123;http://+:5123
FRONTEND_ORIGIN=https://localhost:4200

# Secrets & Security
JWT_SECRET=ReplaceWithAtLeast32ByteCryptographicallySecureKey2026!
JWT_ISSUER=https://localhost:7123
JWT_AUDIENCE=https://localhost:4200
DATA_PROTECTION_KEY_PATH=/root/.aspnet/DataProtection-Keys
